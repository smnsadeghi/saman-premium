# ==============================================================================
# Supabase Configuration
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ==============================================================================
# Closed System Whitelist (Only these 2 emails are allowed)
# Note: Matching is strictly case-insensitive (.toLowerCase())
# ==============================================================================
ALLOWED_EMAIL_HER=her@example.com
ALLOWED_EMAIL_HIM=him@example.com

# Public versions for client-side early validation if needed
NEXT_PUBLIC_ALLOWED_EMAIL_HER=her@example.com
NEXT_PUBLIC_ALLOWED_EMAIL_HIM=him@example.com
